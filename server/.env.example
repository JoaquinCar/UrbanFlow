# Server
PORT=3000
NODE_ENV=development

# Zona horaria. El cron de cuotas y NOW() deben coincidir; en Railway/Render el
# contenedor arranca en UTC y el job del día 1 caería en el mes equivocado.
TZ=America/Mazatlan

# URL pública del backend — la usan los webhooks de MercadoPago y Meta.
# En local: ngrok http 3000
PUBLIC_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=urbanflow
DB_USER=postgres
DB_PASSWORD=urbanflow2026

# JWT
JWT_SECRET=change_this_secret_key
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# QR de residentes. Secret PROPIO, distinto de JWT_SECRET: estos tokens no
# expiran nunca, así que no deben poder firmarse con la llave de sesión.
QR_SECRET=change_this_qr_secret

# Cuotas
MONTO_CUOTA_MENSUAL=1500

# Uploads de documentos de propietarios
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# MercadoPago
# Dejar VACÍO si no hay credenciales: el checkout responderá 500 con un mensaje
# explícito en vez de fallar de forma confusa contra la API.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_CURRENCY=MXN
MP_BACK_URL_SUCCESS=http://localhost:5173/pagos/exito
MP_BACK_URL_FAILURE=http://localhost:5173/pagos/error
MP_BACK_URL_PENDING=http://localhost:5173/pagos/pendiente

# Email (Nodemailer). Vacío = el envío de comunicados por email responde 500.
# Gmail en desarrollo: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 y una App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="UrbanFlow <no-reply@urbanflow.mx>"

# Meta Cloud API (WhatsApp). Vacío = el broadcast por WhatsApp responde 500.
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_API_VERSION=v21.0
# Meta solo entrega texto libre dentro de la ventana de 24h de atención. Para un
# broadcast en frío hace falta una plantilla aprobada; sin ella la API responde
# 200 y el mensaje nunca llega. Vacío = se manda texto libre.
META_TEMPLATE_NAME=
META_TEMPLATE_LANG=es_MX

# CORS
CLIENT_URL=http://localhost:5173

# Seed y pruebas
SEED_PASSWORD=UrbanFlow2026!
SMOKE_URL=http://localhost:3000/api
# Intentos de login por IP cada 15 min. Súbelo solo en local: las pruebas de
# extremo a extremo encadenan muchos logins y agotarían el límite real.
LOGIN_MAX_INTENTOS=10
